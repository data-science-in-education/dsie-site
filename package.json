{
  "name": "dsie-website",
  "version": "1.0.0",
  "description": "Data Science in Education website with Notion CMS integration",
  "main": "index.js",
  "scripts": {
    "mint-meetup-token": "node scripts/meetup-mint-token.js",
    "fetch-notion": "node scripts/notion-fetch.js",
    "og":           "node scripts/og-image.js",
    "build-data":   "npm run fetch-notion && npm run og",
    "serve":        "python3 -m http.server 8000",
    "dev":          "npm run build-data && npm run serve"
  },
  "keywords": [
    "data-science",
    "education",
    "notion",
    "meetup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
