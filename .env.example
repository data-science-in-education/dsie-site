# --- Meetup (drives upcoming.html) ------------------------------------
# OAuth token from https://secure.meetup.com/meetup_api/oauth_consumers/
# Requires a Meetup Pro subscription.
MEETUP_OAUTH_TOKEN=your_meetup_oauth_token_here
MEETUP_GROUP_URLNAME=data-science-in-education

# --- Notion (drives past.html / past-talk.html) -----------------------
# Integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxx
NOTION_EVENTS_DB_ID=xxxxxxxxxxxxx
